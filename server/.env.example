HOST=127.0.0.1
PORT=4300
DATABASE_URL=postgresql://atms:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/atms?schema=public
# F01: 운영에서는 NODE_ENV=production과 명시적 HTTPS Origin이 필수다. 로컬 HTTP만 개발 쿠키를 사용한다.
AUTH_WEB_ORIGIN=http://127.0.0.1:4173
# [F01 가입/복구] 개발 기본값은 외부 전달이 없는 Mailpit이다. 실제 비밀값을 이 파일에 넣지 않는다.
# 운영에는 SMTP_HOST/PORT/FROM/USER/PASSWORD와 SMTP_TLS=tls 또는 starttls를 모두 지정한다.
# SMTP_TLS=local은 개발 루프백 전용이며 운영에서는 거부한다.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@atms.test
SMTP_TLS=local

# [F03] 비공개 R2 전용 버킷. 실제 비밀값은 로컬 .env에만 넣고 채팅/로그/저장소에 공개하지 않는다.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 개발 clamd는 루프백13310, 운영은 Docker 내부 clamav:3310이다.
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=13310
