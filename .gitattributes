# Prisma records migration checksums byte-for-byte. Keep SQL stable across Windows and Linux.
server/prisma/migrations/**/*.sql text eol=lf
# Some legacy production migrations were applied with mixed line endings. Deployments must retain
# those already-applied bytes after proving the normalized SQL content is identical.

# These files execute in Linux containers or on the home server.
*.sh text eol=lf
Dockerfile text eol=lf
